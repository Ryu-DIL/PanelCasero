# Clave secreta compartida con la app del iPhone (la cámara).
# Genera una con:  openssl rand -hex 24
PANEL_TOKEN=cambia-esto

# PIN para entrar en la web desde el móvil (entre 4 y 8 dígitos).
PANEL_PIN=1234

# Dirección del iPhone en tu red (IP reservada en el router) y puerto del directo.
PANEL_CAMERA_URL=http://192.168.1.XXX:8081

# Días que se guardan las fotos y clips (por defecto 30).
# PANEL_RETENTION_DAYS=30

# Cada cuántos segundos se consulta el estado de las luces (por defecto 10).
# PANEL_POLL_SECONDS=10
